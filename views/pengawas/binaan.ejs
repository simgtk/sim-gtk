<%- include('../partials/head') %>
<%- include('../partials/topbar') %>
<div class="shell">
  <%- include('../partials/sidebar') %>
  <main class="main">
    
    <!-- BREADCRUMB & HEADER -->
    <div class="breadcrumb">
      <a href="/sim-gtk/beranda">Beranda</a>
      <span class="sep">/</span>
      <a href="/sim-gtk/pengawas/dashboard">Panel Pengawas</a>
      <span class="sep">/</span>
      <span>Sekolah/Madrasah Binaan</span>
    </div>

    <div class="page-header flex justify-between align-center wrap gap-1">
      <div>
        <h1 class="page-title flex align-center gap-1">
          <svg class="ic text-green" style="width:28px;height:28px"><use href="#i-school"></use></svg>
          Daftar Sekolah / Madrasah Binaan
        </h1>
        <p class="muted">Satuan pendidikan yang secara resmi ditugaskan kepada Pengawas <%= user.nama %> berdasarkan SK Dinas Kanwil Kemenag.</p>
      </div>
      <div>
        <span class="badge badge-success"><%= binaans.length %> Lembaga Binaan Aktif</span>
      </div>
    </div>

    <!-- FLASH MESSAGE -->
    <% if (flash) { %>
      <div class="alert alert-<%= flash.type %> mb-3">
        <%= flash.message %>
      </div>
    <% } %>

    <!-- GRID KARTU MADRASAH BINAAN -->
    <div class="grid grid-3 gap-2 mb-3">
      <% binaans.forEach(function(b) { %>
        <div class="card p-3" style="border: 1px solid var(--line);border-radius:10px">
          <div class="flex justify-between align-center mb-2">
            <span class="badge badge-info"><%= b.jenjang %></span>
            <span class="badge badge-success">Binaan Aktif</span>
          </div>

          <h3 style="font-size:16px;margin:0 0 6px"><%= b.nama %></h3>
          <div class="tiny muted mb-2">NPSN: <%= b.npsn || '-' %> &middot; Wilayah: <%= b.wilayah || 'Kab. Gorontalo' %></div>

          <div class="p-2 mb-2" style="background:var(--bg-subtle);border-radius:6px;font-size:12px;line-height:1.5">
            <div><b>Kepala Madrasah:</b> <%= b.nama_kamad || '-' %></div>
            <div><b>Alamat:</b> <%= b.alamat || '-' %>, <%= b.kabupaten %></div>
            <div><b>Kontak:</b> <%= b.telepon || '-' %> &middot; <%= b.email || '-' %></div>
            <div><b>No. SK Penugasan:</b> <span class="font-mono"><%= b.nomor_sk || '-' %></span></div>
          </div>

          <div class="flex gap-1 justify-between align-center mt-2">
            <a href="/sim-gtk/penilaian/jadwal" class="btn btn-outline btn-sm btn-block text-center">
              <svg class="ic ic-sm"><use href="#i-calendar"></use></svg> Jadwal Supervisi
            </a>
            <a href="/sim-gtk/pengawas/rekomendasi" class="btn btn-primary btn-sm btn-block text-center">
              <svg class="ic ic-sm"><use href="#i-clipboard"></use></svg> Rekomendasi
            </a>
          </div>
        </div>
      <% }); %>
    </div>

    <!-- PRINSIP PEMBATASAN AKSES PENGAWAS -->
    <div class="card p-3" style="border-left:4px solid var(--blue-600);font-size:13px;line-height:1.6">
      <h4 style="margin:0 0 6px;font-size:14px">Ketentuan Akses Pengawas Pembina</h4>
      <ul style="margin:0;padding-left:18px">
        <li>Pengawas hanya memiliki hak akses operasional supervisi dan pembinaan pada lembaga yang tercatat aktif dalam penugasannya.</li>
        <li>Pengawas dapat melihat informasi GTK relevan untuk pembinaan, namun tidak mengubah data kepegawaian induk atau akun admin.</li>
        <li>Jika masa penugasan pada SK berakhir atau dialihkan oleh Superadmin/Kanwil, akses ke lembaga tersebut akan dihentikan secara otomatis.</li>
      </ul>
    </div>

  </main>
</div>
<%- include('../partials/footer') %>
