<%- include('../partials/head', { title: "Data Ijazah & Pendidikan Formal", bodyClass: '' }) %>
<%- include('../partials/topbar') %>
<div class="shell">
  <%- include('../partials/sidebar') %>
  <main class="main">

    <div class="crumbs no-print">
      <a href="/sim-gtk/beranda">SIM-GTK</a> <span>/</span> <a href="/sim-gtk/portofolio/data-diri">Portofolio</a> <span>/</span> <b>Data Ijazah</b>
    </div>
    
    <% if (flash) { %>
      <div class="alert alert-<%= flash.type %> mb-3">
        <svg class="ic"><use href="#i-info"></use></svg>
        <div><%= flash.message %></div>
      </div>
    <% } %>

    <div class="page-head flex justify-between align-center">
      <div>
        <h1>Riwayat Pendidikan &amp; Ijazah</h1>
        <p>Portofolio riwayat pendidikan formal dan arsip nomor ijazah GTK</p>
      </div>
      <a href="/sim-gtk/portofolio/data-diri" class="btn btn-outline btn-sm">
        <svg class="ic ic-sm"><use href="#i-arrow-left"></use></svg> Kembali ke Profil
      </a>
    </div>

    <div class="grid" style="grid-template-columns:1fr 1.6fr;gap:20px">
      <!-- FORM INPUT IJAZAH -->
      <div class="card">
        <div class="card-head">
          <div>
            <h3>Tambah Riwayat Ijazah</h3>
            <p>Masukkan jenjang dan data kelulusan resmi</p>
          </div>
        </div>
        <form method="post" action="/sim-gtk/administrasi/ijazah">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-grid">
            <div class="field">
              <label>Jenjang Pendidikan *</label>
              <select name="jenjang" required class="form-control">
                <option value="">— Pilih Jenjang —</option>
                <option value="SMA/MA/SMK">SMA / MA / SMK</option>
                <option value="D3">Diploma 3 (D3)</option>
                <option value="D4">Diploma 4 (D4)</option>
                <option value="S1">Sarjana (S1)</option>
                <option value="S2">Magister (S2)</option>
                <option value="S3">Doktor (S3)</option>
              </select>
            </div>
            <div class="field">
              <label>Tahun Lulus *</label>
              <input type="number" name="thn_lulus" min="1960" max="2035" placeholder="Contoh: 2012" required class="form-control">
            </div>
            <div class="field span-2">
              <label>Nama Perguruan Tinggi / Sekolah *</label>
              <input type="text" name="institusi" placeholder="Contoh: Universitas Negeri Gorontalo" required class="form-control">
            </div>
            <div class="field span-2">
              <label>Jurusan / Program Studi</label>
              <input type="text" name="jurusan" placeholder="Contoh: Pendidikan Informatika" class="form-control">
            </div>
            <div class="field">
              <label>Tahun Masuk</label>
              <input type="number" name="thn_masuk" min="1960" max="2035" placeholder="Contoh: 2008" class="form-control">
            </div>
            <div class="field">
              <label>Gelar Kelulusan</label>
              <input type="text" name="gelar" placeholder="Contoh: S.Pd / M.Pd" class="form-control">
            </div>
            <div class="field">
              <label>Indeks Prestasi (IPK)</label>
              <input type="text" name="ipk" placeholder="Contoh: 3.75" class="form-control">
            </div>
            <div class="field">
              <label>Nomor Ijazah</label>
              <input type="text" name="no_ijazah" placeholder="Contoh: IJZ-UNG-2012-0841" class="form-control">
            </div>
          </div>
          <button class="btn btn-primary btn-block mt-3" type="submit">
            <svg class="ic ic-sm" aria-hidden="true"><use href="#i-save"></use></svg> Simpan Data Ijazah
          </button>
        </form>
      </div>

      <!-- DAFTAR IJAZAH -->
      <div class="card">
        <div class="card-head flex justify-between align-center">
          <div>
            <h3>Daftar Ijazah Terdaftar</h3>
            <p><%= ijazahList.length %> tingkat pendidikan tercatat</p>
          </div>
          <% if (ijazahList.length > 0) { %>
            <span class="badge badge-teal">Pendidikan Tertinggi: <%= ijazahList[0].jenjang %></span>
          <% } %>
        </div>

        <% if (ijazahList.length === 0) { %>
          <div class="list-empty">
            <svg class="ic" aria-hidden="true"><use href="#i-graduation"></use></svg>
            <b>Belum ada data ijazah tercatat</b>
            Silakan tambahkan riwayat pendidikan formal melalui formulir di samping.
          </div>
        <% } else { %>
          <div class="stack gap-2 mt-2">
            <% ijazahList.forEach(ijz => { %>
              <div class="p-3" style="border:1px solid var(--line);border-radius:8px;background:var(--bg-subtle)">
                <div class="flex justify-between align-start">
                  <div class="flex gap-2">
                    <div class="avatar" style="width:40px;height:40px;background:var(--blue-700);color:#fff;font-size:12px;font-weight:700">
                      <%= ijz.jenjang %>
                    </div>
                    <div>
                      <div class="font-bold" style="font-size:15px"><%= ijz.institusi %></div>
                      <div class="small muted"><%= ijz.jurusan || 'Semua Jurusan' %> &bull; Gelar: <b><%= ijz.gelar || '-' %></b></div>
                      <div class="tiny mt-1 text-secondary">
                        Tahun: <%= ijz.thn_masuk || '?' %> s.d. <b><%= ijz.thn_lulus || '?' %></b> | IPK: <b><%= ijz.ipk || '-' %></b>
                      </div>
                      <div class="tiny font-mono mt-1" style="color:var(--text-muted)">
                        No. Ijazah: <b><%= ijz.no_ijazah || '(Belum dicatat)' %></b>
                      </div>
                    </div>
                  </div>
                  <div>
                    <form method="post" action="/sim-gtk/administrasi/ijazah/<%= ijz.id %>/hapus" onsubmit="return confirm('Apakah Anda yakin ingin menghapus data ijazah ini?')">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-sm btn-outline text-danger" type="submit" title="Hapus">
                        <svg class="ic ic-sm"><use href="#i-trash"></use></svg>
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>
    
    <div class="tiny muted mt-4" style="padding-top:18px;border-top:1px solid var(--line)">
      SIM-GTK &mdash; Sistem Informasi Manajemen Guru dan Tenaga Kependidikan Madrasah.
    </div>
  </main>
</div>
<%- include('../partials/footer') %>
