<%- include('../partials/head', { title: "Konfigurasi Instrumen Supervisi — SIM-GTK", bodyClass: '' }) %>
<%- include('../partials/topbar') %>
<div class="shell">
  <%- include('../partials/sidebar', { currentMenu: 'penilaian', activeSub: 'instrumen' }) %>
  <main class="main">
    
    <!-- BREADCRUMB -->
    <div class="breadcrumb no-print">
      <a href="/sim-gtk/beranda">SIM-GTK</a>
      <span class="sep">/</span>
      <a href="/sim-gtk/penilaian/akademik">Penilaian</a>
      <span class="sep">/</span>
      <span>Pengaturan Butir Instrumen Fleksibel</span>
    </div>

    <!-- PAGE HEADER -->
    <div class="page-header flex justify-between align-center wrap gap-2 no-print mb-4">
      <div>
        <h1 class="page-title flex align-center gap-1">
          <svg class="ic text-blue" style="width:28px;height:28px"><use href="#i-settings"></use></svg>
          Konfigurasi Butir Penilaian Supervisi (Fleksibel &amp; Adaptif)
        </h1>
        <p class="muted">
          Kewenangan penentuan instrumen: <b>Superadmin</b> (Master Nasional), <b>Pengawas Pembina</b> &amp; <b>Kepala Madrasah</b> (Penyesuaian Satuan Madrasah). Butir dapat ditambah, diubah indikatornya, atau digeser urutannya sesuai kurikulum aktif.
        </p>
      </div>
      <div class="flex gap-2 wrap align-center">
        <a href="/sim-gtk/penilaian/akademik" class="btn btn-outline btn-sm flex align-center gap-1">
          <svg class="ic ic-sm"><use href="#i-check-square"></use></svg> Ke Lembar Penilaian
        </a>
        <button type="button" class="btn btn-primary btn-sm flex align-center gap-1" onclick="openModalTambahButir()">
          <svg class="ic ic-sm"><use href="#i-plus"></use></svg> Tambah Butir Baru
        </button>
      </div>
    </div>

    <!-- FLASH MESSAGE -->
    <% if (flash) { %>
      <div class="alert alert-<%= flash.type %> mb-4">
        <%= flash.message %>
      </div>
    <% } %>

    <!-- INFO BOX KEBIJAKAN HAK AKSES -->
    <div class="card mb-4 p-3" style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:14px">
      <div class="flex align-center gap-3 wrap">
        <div style="width:40px;height:40px;border-radius:10px;background:#10b981;color:#fff;display:grid;place-items:center;flex-shrink:0">
          <svg class="ic" style="width:22px;height:22px"><use href="#i-check-circle"></use></svg>
        </div>
        <div style="flex:1">
          <div class="font-bold" style="color:#065f46;font-size:14px">Instrumen Supervisi Fleksibel &amp; Tidak Kaku</div>
          <div class="tiny text-muted">
            Format butir dapat disesuaikan sewaktu-waktu mengikuti Keputusan Direktur Jenderal Pendidikan Islam (Kepdirjen Pendis), IKM Kurikulum Merdeka, maupun fokus pengawasan tematik wilayah binaan.
          </div>
        </div>
        <div>
          <span class="badge badge-success font-bold">Terbuka untuk Kamad, Pengawas &amp; Superadmin</span>
        </div>
      </div>
    </div>

    <!-- DOMAIN TABS -->
    <div class="tabs mb-4">
      <a href="#tab-administrasi" class="active" onclick="switchDomainTab('administrasi', this)">
        1. Administrasi Pembelajaran (<%= (instrumen.administrasi && instrumen.administrasi.items) ? instrumen.administrasi.items.length : 5 %> Butir)
      </a>
      <a href="#tab-modul" onclick="switchDomainTab('modul_ajar', this)">
        2. Perencanaan Modul Ajar (<%= (instrumen.modul_ajar && instrumen.modul_ajar.items) ? instrumen.modul_ajar.items.length : 5 %> Butir)
      </a>
      <a href="#tab-pengamatan" onclick="switchDomainTab('pengamatan', this)">
        3. Observasi Kelas (<%= (instrumen.pengamatan && instrumen.pengamatan.items) ? instrumen.pengamatan.items.length : 5 %> Butir)
      </a>
      <a href="#tab-penilaian" onclick="switchDomainTab('penilaian', this)">
        4. Asesmen Penilaian (<%= (instrumen.penilaian && instrumen.penilaian.items) ? instrumen.penilaian.items.length : 5 %> Butir)
      </a>
    </div>

    <!-- LOOP PER DOMAIN -->
    <% const domainKeys = ['administrasi', 'modul_ajar', 'pengamatan', 'penilaian']; %>
    <% domainKeys.forEach(function(domKey, domIdx) { %>
      <% const currentDom = instrumen[domKey]; %>
      <div class="domain-content-section <%= domIdx === 0 ? '' : 'hidden' %>" id="section-<%= domKey %>">
        
        <div class="card mb-4" style="padding:0;overflow:hidden;border-radius:16px">
          <div class="card-head p-3 flex justify-between align-center wrap gap-2" style="background:#f8fafc;border-bottom:1px solid var(--line);margin:0">
            <div>
              <h3 style="font-size:16px;color:var(--navy-900);font-weight:700">
                <%= currentDom ? currentDom.title : domKey %>
              </h3>
              <p class="tiny muted" style="margin-top:2px">
                <%= currentDom ? currentDom.desc : '' %> &middot; Drag baris untuk mengatur urutan penomoran.
              </p>
            </div>
            <div>
              <button type="button" class="btn btn-outline btn-sm flex align-center gap-1" onclick="openModalTambahButir('<%= domKey %>')">
                <svg class="ic ic-sm"><use href="#i-plus"></use></svg> Tambah Butir pada Domain Ini
              </button>
            </div>
          </div>

          <div class="table-responsive plain">
            <table class="table tbl table-mobile-card mb-0">
              <thead>
                <tr>
                  <th style="width:40px;text-align:center">Geser</th>
                  <th style="width:70px">Kode</th>
                  <th style="min-width:240px">Bunyi Butir Penilaian</th>
                  <th style="min-width:320px">Deskripsi Indikator Skor (1 - 4)</th>
                  <th style="width:90px;text-align:center">Bobot</th>
                  <th style="width:120px;text-align:center">Aksi</th>
                </tr>
              </thead>
              <tbody class="sortable-butir-list" data-domain="<%= domKey %>">
                <% if (currentDom && currentDom.items && currentDom.items.length > 0) { %>
                  <% currentDom.items.forEach(function(item, idx) { %>
                    <tr class="drag-item" draggable="true" data-id="<%= item.db_id || item.id %>" ondragstart="handleRowDragStart(event)" ondragover="handleRowDragOver(event)" ondrop="handleRowDrop(event)">
                      <td data-label="Geser" style="text-align:center;color:#94a3b8;cursor:grab">
                        <svg class="ic ic-sm"><use href="#i-grid"></use></svg>
                      </td>
                      <td data-label="Kode">
                        <span class="butir-code"><%= item.id %></span>
                      </td>
                      <td data-label="Bunyi Butir">
                        <div class="font-bold" style="color:var(--navy-900);font-size:13.5px"><%= item.label %></div>
                        <div class="tiny text-muted">Penetapan: Madrasah &amp; Kemenag</div>
                      </td>
                      <td data-label="Indikator Skor">
                        <div class="tiny" style="line-height:1.45">
                          <span class="text-red font-bold">1:</span> <%= item.indikator_1 || 'Belum memenuhi kriteria dasar' %><br>
                          <span class="text-orange font-bold">2:</span> <%= item.indikator_2 || 'Sebagian kriteria terpenuhi' %><br>
                          <span class="text-blue font-bold">3:</span> <%= item.indikator_3 || 'Lengkap sesuai standar standar' %><br>
                          <span class="text-green font-bold">4:</span> <%= item.indikator_4 || 'Sangat komprehensif, inovatif & kontekstual' %>
                        </div>
                      </td>
                      <td data-label="Bobot" style="text-align:center">
                        <span class="badge badge-teal font-bold"><%= item.weight || 1 %>x</span>
                      </td>
                      <td data-label="Aksi" style="text-align:center">
                        <div class="flex justify-center gap-1">
                          <button type="button" class="btn btn-outline btn-xs" onclick='editButir(<%= JSON.stringify(item) %>, "<%= domKey %>")'>
                            <svg class="ic ic-sm"><use href="#i-edit"></use></svg> Edit
                          </button>
                          <form method="post" action="/sim-gtk/penilaian/instrumen/hapus" style="display:inline" onsubmit="return confirm('Hapus butir penilaian ini?')">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="id" value="<%= item.db_id || item.id %>">
                            <button type="submit" class="btn btn-danger btn-xs">
                              <svg class="ic ic-sm"><use href="#i-trash"></use></svg>
                            </button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="6" class="center muted p-4">Belum ada butir penilaian dalam domain ini.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

      </div>
    <% }); %>

    <!-- MODAL FORM TAMBAH / EDIT BUTIR SUPERVISI -->
    <div class="modal" id="modalButir">
      <div class="modal-dialog modal-lg">
        <form method="post" action="/sim-gtk/penilaian/instrumen/simpan" id="formButir">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="id" id="butir_id" value="">

          <div class="modal-head">
            <h3 id="modalButirTitle">Tambah Butir Penilaian Supervisi Baru</h3>
            <button type="button" class="btn-close" onclick="closeModalButir()">&times;</button>
          </div>

          <div class="modal-body">
            <div class="grid grid-3 gap-2 mb-3">
              <div class="field">
                <label class="form-label required">Domain / Menu</label>
                <select name="domain" id="butir_domain" class="form-control" required>
                  <option value="administrasi">1. Administrasi Pembelajaran</option>
                  <option value="modul_ajar">2. Perencanaan Modul Ajar (RPP)</option>
                  <option value="pengamatan">3. Pengamatan Pembelajaran</option>
                  <option value="penilaian">4. Penilaian / Asesmen</option>
                </select>
              </div>

              <div class="field">
                <label class="form-label required">Kode Butir</label>
                <input type="text" name="kode" id="butir_kode" class="form-control" required placeholder="Contoh: A6, B6, C6">
              </div>

              <div class="field">
                <label class="form-label required">Bobot Penilaian</label>
                <input type="number" step="0.1" name="bobot" id="butir_bobot" class="form-control" required value="1.0">
              </div>
            </div>

            <div class="field mb-3">
              <label class="form-label required">Bunyi Rumusan Butir Penilaian</label>
              <textarea name="label" id="butir_label" class="form-control" rows="2" required placeholder="Masukkan indikator atau dokumen yang disupervisi..."></textarea>
            </div>

            <div class="card p-3 mb-2" style="background:#f8fafc;border:1px solid var(--line);border-radius:12px">
              <div class="tiny font-bold uppercase muted mb-2">Deskripsi Kriteria Rubrik Skor 1 s.d. 4:</div>
              
              <div class="field mb-2">
                <label class="form-label text-red">Indikator Skor 1 (Kurang)</label>
                <input type="text" name="indikator_1" id="butir_ind_1" class="form-control" placeholder="Kondisi jika guru mendapat skor 1...">
              </div>

              <div class="field mb-2">
                <label class="form-label text-orange">Indikator Skor 2 (Cukup)</label>
                <input type="text" name="indikator_2" id="butir_ind_2" class="form-control" placeholder="Kondisi jika guru mendapat skor 2...">
              </div>

              <div class="field mb-2">
                <label class="form-label text-blue">Indikator Skor 3 (Baik)</label>
                <input type="text" name="indikator_3" id="butir_ind_3" class="form-control" placeholder="Kondisi jika guru mendapat skor 3...">
              </div>

              <div class="field">
                <label class="form-label text-green">Indikator Skor 4 (Sangat Baik)</label>
                <input type="text" name="indikator_4" id="butir_ind_4" class="form-control" placeholder="Kondisi jika guru mendapat skor 4 (sempurna/inovatif)...">
              </div>
            </div>
          </div>

          <div class="modal-foot">
            <button type="button" class="btn btn-outline" onclick="closeModalButir()">Batal</button>
            <button type="submit" class="btn btn-primary">Simpan Butir Penilaian</button>
          </div>
        </form>
      </div>
    </div>

  </main>
</div>

<script>
function switchDomainTab(domain, el) {
  document.querySelectorAll('.tabs a').forEach(a => a.classList.remove('active'));
  el.classList.add('active');
  document.querySelectorAll('.domain-content-section').forEach(s => s.classList.add('hidden'));
  const target = document.getElementById('section-' + domain);
  if (target) target.classList.remove('hidden');
}

function openModalTambahButir(domain = 'administrasi') {
  document.getElementById('formButir').reset();
  document.getElementById('butir_id').value = '';
  document.getElementById('butir_domain').value = domain;
  document.getElementById('modalButirTitle').innerText = 'Tambah Butir Penilaian Baru';
  document.getElementById('modalButir').classList.add('open');
}

function closeModalButir() {
  document.getElementById('modalButir').classList.remove('open');
}

function editButir(item, domain) {
  document.getElementById('butir_id').value = item.db_id || item.id;
  document.getElementById('butir_domain').value = domain;
  document.getElementById('butir_kode').value = item.id;
  document.getElementById('butir_label').value = item.label;
  document.getElementById('butir_bobot').value = item.weight || 1;
  document.getElementById('butir_ind_1').value = item.indikator_1 || '';
  document.getElementById('butir_ind_2').value = item.indikator_2 || '';
  document.getElementById('butir_ind_3').value = item.indikator_3 || '';
  document.getElementById('butir_ind_4').value = item.indikator_4 || '';
  document.getElementById('modalButirTitle').innerText = 'Edit Butir Penilaian: ' + item.id;
  document.getElementById('modalButir').classList.add('open');
}

// Drag & drop row reordering
let draggedRow = null;
function handleRowDragStart(e) {
  draggedRow = e.currentTarget;
  e.dataTransfer.effectAllowed = 'move';
  draggedRow.classList.add('dragging');
}

function handleRowDragOver(e) {
  e.preventDefault();
  const tr = e.currentTarget;
  if (tr !== draggedRow && tr.parentNode === draggedRow.parentNode) {
    const rect = tr.getBoundingClientRect();
    const next = (e.clientY - rect.top) / (rect.bottom - rect.top) > 0.5;
    tr.parentNode.insertBefore(draggedRow, next ? tr.nextSibling : tr);
  }
}

function handleRowDrop(e) {
  e.preventDefault();
  if (draggedRow) {
    draggedRow.classList.remove('dragging');
    const tbody = draggedRow.parentNode;
    const ids = Array.from(tbody.querySelectorAll('tr')).map(r => r.getAttribute('data-id')).filter(Boolean);
    
    // Kirim AJAX reorder
    fetch('/sim-gtk/penilaian/instrumen/reorder', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': '<%= csrfToken %>'
      },
      body: JSON.stringify({ itemIds: ids, _csrf: '<%= csrfToken %>' })
    }).then(res => res.json()).then(data => {
      const toast = document.createElement('div');
      toast.className = 'toast-notice show';
      toast.innerHTML = '<svg class="ic ic-sm" style="color:#10b981"><use href="#i-check"></use></svg> Urutan butir berhasil disimpan otomatis!';
      document.body.appendChild(toast);
      setTimeout(() => {
        toast.classList.remove('show');
        setTimeout(() => toast.remove(), 300);
      }, 2000);
    }).catch(err => console.log('Reorder saved locally'));
  }
}
</script>

<%- include('../partials/footer') %>
