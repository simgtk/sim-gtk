<%- include('../partials/head', { title: "Supervisi Mengajar (Observasi Kelas) — SIM-GTK", bodyClass: '' }) %>
<%- include('../partials/topbar') %>
<div class="shell">
  <%- include('../partials/sidebar', { currentMenu: 'penilaian', activeSub: 'mengajar' }) %>
  <main class="main">
    
    <!-- BREADCRUMB -->
    <div class="breadcrumb no-print">
      <a href="/sim-gtk/beranda">SIM-GTK</a>
      <span class="sep">/</span>
      <a href="/sim-gtk/penilaian/jadwal">Penilaian</a>
      <span class="sep">/</span>
      <span>Supervisi Mengajar</span>
    </div>

    <!-- PAGE HEADER -->
    <div class="page-header flex justify-between align-center wrap gap-2 no-print mb-4">
      <div>
        <h1 class="page-title flex align-center gap-1">
          <svg class="ic text-blue" style="width:28px;height:28px"><use href="#i-presentation"></use></svg>
          Supervisi Praktik Mengajar (Observasi Kelas)
        </h1>
        <p class="muted">
          Penilaian observasi tatap muka langsung: pengkondisian awal &amp; motivasi, kegiatan inti diferensiasi, interaksi positif siswa, dan penutup bermakna.
        </p>
      </div>
      <div class="flex gap-2 wrap align-center">
        <button type="button" class="btn btn-outline btn-sm flex align-center gap-1" onclick="window.print()">
          <svg class="ic ic-sm"><use href="#i-print"></use></svg> Cetak Rekap Observasi
        </button>
        <button type="button" class="btn btn-primary btn-sm flex align-center gap-1" onclick="document.getElementById('modalObservasiMengajar').style.display='flex'">
          <svg class="ic ic-sm"><use href="#i-plus"></use></svg> Tambah Observasi Kelas
        </button>
      </div>
    </div>

    <!-- FLASH MESSAGE -->
    <% if (flash) { %>
      <div class="alert alert-<%= flash.type %> mb-4">
        <%= flash.message %>
      </div>
    <% } %>

    <!-- KPI STATISTIK MENGAJAR -->
    <div class="grid grid-4 mb-4">
      <div class="card p-3 flex align-center gap-3">
        <div class="stat-icon bg-blue-subtle text-blue" style="width:48px;height:48px;border-radius:12px;background:var(--blue-50);display:grid;place-items:center">
          <svg class="ic" style="width:24px;height:24px"><use href="#i-presentation"></use></svg>
        </div>
        <div>
          <div class="tiny uppercase font-bold muted" style="letter-spacing:0.5px">Observasi Terlaksana</div>
          <div style="font-size:22px;font-weight:800;color:var(--navy-800)"><%= mengajarList.length %> Sesi</div>
          <div class="tiny text-blue font-bold">Tatap Muka di Kelas</div>
        </div>
      </div>

      <div class="card p-3 flex align-center gap-3">
        <div class="stat-icon" style="width:48px;height:48px;border-radius:12px;background:var(--green-bg);color:var(--green);display:grid;place-items:center">
          <svg class="ic" style="width:24px;height:24px"><use href="#i-sparkles"></use></svg>
        </div>
        <div>
          <div class="tiny uppercase font-bold muted" style="letter-spacing:0.5px">Kegiatan Awal</div>
          <div style="font-size:22px;font-weight:800;color:var(--green-800)"><%= avgAwal %> / 100</div>
          <div class="tiny text-green font-bold">Apersepsi &amp; Kesiapan</div>
        </div>
      </div>

      <div class="card p-3 flex align-center gap-3">
        <div class="stat-icon" style="width:48px;height:48px;border-radius:12px;background:#f3e8ff;color:#7e22ce;display:grid;place-items:center">
          <svg class="ic" style="width:24px;height:24px"><use href="#i-book-open"></use></svg>
        </div>
        <div>
          <div class="tiny uppercase font-bold muted" style="letter-spacing:0.5px">Kegiatan Inti</div>
          <div style="font-size:22px;font-weight:800;color:#7e22ce"><%= avgInti %> / 100</div>
          <div class="tiny font-bold text-purple">Diferensiasi &amp; Kolaborasi</div>
        </div>
      </div>

      <div class="card p-3 flex align-center gap-3">
        <div class="stat-icon" style="width:48px;height:48px;border-radius:12px;background:#fef3c7;color:#b45309;display:grid;place-items:center">
          <svg class="ic" style="width:24px;height:24px"><use href="#i-award"></use></svg>
        </div>
        <div>
          <div class="tiny uppercase font-bold muted" style="letter-spacing:0.5px">Nilai Akhir Observasi</div>
          <div style="font-size:22px;font-weight:800;color:#b45309"><%= avgTotal %></div>
          <div class="tiny font-bold text-orange">Predikat: Amat Baik</div>
        </div>
      </div>
    </div>

    <!-- TABEL HASIL OBSERVASI MENGAJAR -->
    <div class="card mb-4" style="padding:0;overflow:hidden">
      <div class="card-head p-3 flex justify-between align-center wrap gap-2" style="background:#f8fafc;border-bottom:1px solid var(--line);margin:0">
        <div>
          <h3 style="font-size:16px;margin:0;color:var(--navy-900)">
            Daftar Rekaman Observasi Mengajar di Kelas
          </h3>
          <p class="tiny muted" style="margin-top:2px">
            Hasil telaah langsung aktivitas pendidik dan peserta didik di ruang kelas nyata.
          </p>
        </div>
        <div>
          <span class="badge badge-teal">Tahun 2026/2027 Ganjil</span>
        </div>
      </div>

      <div class="table-responsive">
        <table class="table tbl mb-0">
          <thead>
            <tr>
              <th style="width:50px;text-align:center">No</th>
              <th style="min-width:210px">Guru yang Diobservasi</th>
              <th style="width:160px">Mata Pelajaran &amp; Kelas</th>
              <th style="min-width:180px">Materi Pokok</th>
              <th style="width:120px">Tanggal</th>
              <th style="min-width:160px">Supervisor</th>
              <th style="width:80px;text-align:center">Awal</th>
              <th style="width:80px;text-align:center">Inti</th>
              <th style="width:80px;text-align:center">Penutup</th>
              <th style="width:95px;text-align:center">Skor Akhir</th>
              <th style="width:120px;text-align:center">Predikat</th>
              <th style="width:120px;text-align:center" class="no-print">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (mengajarList.length === 0) { %>
              <tr>
                <td colspan="12" class="center muted p-4">Belum ada rekaman observasi mengajar. Klik "Tambah Observasi Kelas" untuk memulai.</td>
              </tr>
            <% } %>
            <% mengajarList.forEach(function(item, idx) { %>
              <tr>
                <td style="text-align:center;font-weight:700;color:var(--muted)"><%= idx + 1 %></td>
                <td>
                  <div style="font-weight:700;color:var(--navy-900)"><%= item.gtk_nama %></div>
                  <div class="tiny muted"><%= item.gtk_nip && item.gtk_nip !== '-' ? 'NIP. ' + item.gtk_nip : 'NUPTK: ' + (item.gtk_nuptk || '-') %></div>
                </td>
                <td>
                  <div style="font-weight:600"><%= item.mapel %></div>
                  <div class="tiny muted">Kelas <%= item.kelas %></div>
                </td>
                <td class="small">
                  <b><%= item.materi %></b>
                </td>
                <td class="nowrap tiny" style="font-weight:600"><%= item.tanggal %></td>
                <td class="small"><%= item.supervisor_nama %></td>
                <td style="text-align:center"><%= item.skor_kegiatan_awal %></td>
                <td style="text-align:center"><%= item.skor_kegiatan_inti %></td>
                <td style="text-align:center"><%= item.skor_kegiatan_penutup %></td>
                <td style="text-align:center">
                  <b style="font-size:15px;color:var(--navy-900)"><%= item.skor_total %></b>
                </td>
                <td style="text-align:center">
                  <% if (item.predikat === 'Amat Baik' || item.skor_total >= 91) { %>
                    <span class="badge badge-success font-bold">Amat Baik</span>
                  <% } else { %>
                    <span class="badge badge-teal font-bold"><%= item.predikat %></span>
                  <% } %>
                </td>
                <td class="no-print nowrap" style="text-align:center">
                  <a class="btn btn-outline btn-sm flex align-center gap-1" href="/sim-gtk/penilaian/laporan?gtk_id=<%= item.gtk_id %>">
                    <svg class="ic ic-sm"><use href="#i-print"></use></svg> Lembar Hasil
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- ============================================================
         MODAL INPUT OBSERVASI MENGAJAR (LEGA & RAPI)
         ============================================================ -->
    <div class="modal-overlay" id="modalObservasiMengajar">
      <div class="modal-card-lg" style="max-width:700px">
        <form method="post" action="/sim-gtk/penilaian/mengajar/simpan">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="modal-header">
            <div>
              <h3 style="font-size:17px;margin:0;color:var(--navy-900);font-weight:700">
                Pencatatan Supervisi Observasi Praktik Mengajar
              </h3>
              <p class="tiny muted" style="margin-top:2px">
                Input evaluasi kegiatan awal, kegiatan inti berdiferensiasi, dan penutup kelas.
              </p>
            </div>
            <button type="button" class="btn btn-ghost" onclick="document.getElementById('modalObservasiMengajar').style.display='none'">
              <svg class="ic"><use href="#i-x"></use></svg>
            </button>
          </div>

          <div class="modal-body-scroll">
            <div class="grid grid-2 gap-3">
              <div class="field span-2">
                <label class="font-bold">Guru yang Diobservasi</label>
                <select name="gtk_id" required>
                  <% gtkList.forEach(function(g) { %>
                    <option value="<%= g.id %>"><%= g.nama %> &mdash; <%= g.mapel_utama || g.jabatan %></option>
                  <% }); %>
                </select>
              </div>

              <div class="field">
                <label class="font-bold">Mata Pelajaran</label>
                <input type="text" name="mapel" value="Informatika" required>
              </div>

              <div class="field">
                <label class="font-bold">Kelas / Rombel</label>
                <input type="text" name="kelas" value="X-A" required>
              </div>

              <div class="field span-2">
                <label class="font-bold">Materi Pokok / Sub-Materi</label>
                <input type="text" name="materi" placeholder="Contoh: Berpikir Komputasional & Struktur Data" value="Berpikir Komputasional dan Pemrograman Dasar" required>
              </div>

              <div class="field">
                <label class="font-bold">Tanggal Observasi</label>
                <input type="date" name="tanggal" value="<%= new Date().toISOString().slice(0, 10) %>" required>
              </div>

              <div class="field">
                <label class="font-bold">Nama Supervisor</label>
                <input type="text" name="supervisor_nama" value="<%= user ? user.nama : 'Drs. H. Abdul Wahab, M.Pd' %>" required>
              </div>

              <div class="field">
                <label class="font-bold">Skor Kegiatan Awal (0 - 100)</label>
                <input type="number" name="skor_awal" min="0" max="100" value="90" required>
                <span class="tiny muted">Bobot 20% (Apersepsi &amp; Motivasi)</span>
              </div>

              <div class="field">
                <label class="font-bold">Skor Kegiatan Inti (0 - 100)</label>
                <input type="number" name="skor_inti" min="0" max="100" value="88" required>
                <span class="tiny muted">Bobot 60% (Eksplorasi &amp; Diferensiasi)</span>
              </div>

              <div class="field span-2">
                <label class="font-bold">Skor Kegiatan Penutup (0 - 100)</label>
                <input type="number" name="skor_penutup" min="0" max="100" value="86" required>
                <span class="tiny muted">Bobot 20% (Refleksi, Rangkuman &amp; Asesmen)</span>
              </div>

              <div class="field span-2">
                <label class="font-bold">Catatan Observasi</label>
                <textarea name="catatan" rows="3" placeholder="Deskripsikan proses pembelajaran...">Guru terampil mengelola kelas dengan metode diskusi kelompok dan studi kasus berbasis laboratorium komputer.</textarea>
              </div>

              <div class="field span-2">
                <label class="font-bold">Rekomendasi Supervisor</label>
                <textarea name="rekomendasi" rows="2" placeholder="Saran pengembangan...">Perbanyak waktu refleksi mandiri bagi peserta didik di akhir kegiatan inti.</textarea>
              </div>
            </div>
          </div>

          <div class="modal-footer">
            <button type="button" class="btn btn-outline" onclick="document.getElementById('modalObservasiMengajar').style.display='none'">
              Batal
            </button>
            <button type="submit" class="btn btn-primary flex align-center gap-1">
              <svg class="ic ic-sm"><use href="#i-check"></use></svg> Simpan Hasil Observasi
            </button>
          </div>
        </form>
      </div>
    </div>

  </main>
</div>
<%- include('../partials/footer') %>
