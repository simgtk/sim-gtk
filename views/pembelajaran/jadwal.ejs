  <div class="stat tint-2"><div><div class="lbl">Mata Pelajaran</div><div class="val">0</div><div class="sub">-</div></div><div class="ico ico-green"><svg class="ic ic-lg" aria-hidden="true"><use href="#i-book"></use></svg></div></div>
