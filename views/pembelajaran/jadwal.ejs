          <tr><td colspan="7"><div class="list-empty"><svg class="ic " aria-hidden="true"><use href="#i-calendar"></use></svg><b>Belum ada jadwal</b>Jadwal ditetapkan admin madrasah.</div></td></tr>
        
      </tbody>
    </table>
  </div>
</div>

<div class="grid grid-2 mt-3">
  <div class="card">
    <div class="card-head"><div><h3>Aktivitas Mengajar</h3><p>Rincian jadwal per hari</p></div></div>
    
      
    
      
    
      
    
      
    
      
    
      
    
