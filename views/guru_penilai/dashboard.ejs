<%- include('../partials/head', { title: "Dashboard Guru Penilai — SIM-GTK", bodyClass: '' }) %>
<%- include('../partials/topbar') %>
<div class="shell">
  <%- include('../partials/sidebar', { currentMenu: 'guru_penilai', activeSub: 'penilai_dashboard' }) %>
  <main class="main">
    
    <!-- BREADCRUMB -->
    <div class="breadcrumb no-print">
      <a href="/sim-gtk/beranda">SIM-GTK</a>
      <span class="sep">/</span>
      <span>Penilaian</span>
      <span class="sep">/</span>
      <span>Panel Guru Penilai</span>
    </div>

    <!-- HERO SECTION WITH ANIMATED GRADIENT (FITUR 7) -->
    <div class="card animated-gradient-hero mb-4 p-4" style="border-radius:18px;border:none">
      <div class="flex justify-between align-center wrap gap-2">
        <div style="max-width:700px">
          <div class="badge badge-warning font-bold uppercase mb-2" style="background:#fef3c7;color:#92400e;border:none">
            <svg class="ic ic-sm"><use href="#i-award"></use></svg> Mandat Resmi Kepala Madrasah
          </div>
          <h1 style="color:#ffffff;font-size:26px;font-weight:800;letter-spacing:-0.02em;margin-bottom:8px">
            Selamat Datang, <%= user.nama %>
          </h1>
          <p style="color:#e0f2fe;font-size:14px;line-height:1.6">
            Anda ditugaskan sebagai <b>Guru Penilai / Pamong Sejawat</b> oleh Kepala Madrasah untuk membantu supervisi akademik, observasi kelas, dan telaah modul ajar guru rumpun mata pelajaran.
          </p>
        </div>
        <div class="flex gap-2 wrap align-center">
          <a href="/sim-gtk/penilaian/akademik" class="btn btn-glow font-bold" style="background:#ffffff;color:var(--navy-900);border-radius:12px;padding:12px 22px">
            <svg class="ic text-blue"><use href="#i-check-square"></use></svg> Input Lembar Supervisi
          </a>
        </div>
      </div>
    </div>

    <!-- FLASH MESSAGE -->
    <% if (flash) { %>
      <div class="alert alert-<%= flash.type %> mb-4">
        <%= flash.message %>
      </div>
    <% } %>

    <!-- KPI STAT CARDS DENGAN BADGE KONSISTEN & LAYOUT HORIZONTAL -->
    <div class="grid grid-4 mb-4">
      <div class="card stat-card">
        <div class="stat-icon bg-blue-subtle text-blue">
          <svg class="ic"><use href="#i-users"></use></svg>
        </div>
        <div class="stat-meta">
          <div class="stat-label">Guru Binaan Mandat</div>
          <div class="stat-value"><%= jadwalList ? jadwalList.length : 6 %> Guru</div>
          <div><span class="badge-status badge-status-aktif">Mandat Aktif</span></div>
        </div>
      </div>

      <div class="card stat-card">
        <div class="stat-icon bg-green-subtle text-green">
          <svg class="ic"><use href="#i-check-circle"></use></svg>
        </div>
        <div class="stat-meta">
          <div class="stat-label">Observasi Selesai</div>
          <div class="stat-value"><%= jadwalList ? jadwalList.filter(j => j.status === 'Selesai').length : 4 %> Sesi</div>
          <div><span class="badge-status badge-status-selesai">Nilai Terbit</span></div>
        </div>
      </div>

      <div class="card stat-card">
        <div class="stat-icon bg-amber-subtle text-orange">
          <svg class="ic"><use href="#i-clock"></use></svg>
        </div>
        <div class="stat-meta">
          <div class="stat-label">Menunggu Jadwal</div>
          <div class="stat-value"><%= jadwalList ? jadwalList.filter(j => j.status === 'Terjadwal').length : 2 %> Sesi</div>
          <div><span class="badge-status badge-status-pending">Menunggu</span></div>
        </div>
      </div>

      <div class="card stat-card">
        <div class="stat-icon bg-purple-subtle text-purple">
          <svg class="ic"><use href="#i-award"></use></svg>
        </div>
        <div class="stat-meta">
          <div class="stat-label">Rata-rata Skor Binaan</div>
          <div class="stat-value">88.4</div>
          <div><span class="badge-status badge-status-terjadwal">Predikat: Amat Baik</span></div>
        </div>
      </div>
    </div>

    <!-- INFORMASI SK PENUGASAN KEPALA MADRASAH -->
    <div class="card mb-4 p-3" style="border:1px solid #bfdbfe;background:#eff6ff;border-radius:14px">
      <div class="flex justify-between align-center wrap gap-2">
        <div class="flex align-center gap-3">
          <div style="width:44px;height:44px;border-radius:10px;background:#3b82f6;color:#fff;display:grid;place-items:center;flex-shrink:0">
            <svg class="ic" style="width:24px;height:24px"><use href="#i-award"></use></svg>
          </div>
          <div>
            <div class="font-bold" style="color:#1e3a8a;font-size:14.5px">
              SK Kepala Madrasah: Penugasan Tim Penilai Kinerja &amp; Supervisi Akademik Guru
            </div>
            <div class="tiny text-muted">
              Nomor SK: <b>Kd.30.01/1/PP.00/177/2026</b> &middot; Ekuivalensi Beban Kerja: <b>2 Jam Tatap Muka (JTM)</b> &middot; TMT: 1 Agustus 2026
            </div>
          </div>
        </div>
        <div>
          <span class="badge-status badge-status-aktif">SK Berlaku</span>
        </div>
      </div>
    </div>

    <!-- ============================================================
         KANBAN INTERAKTIF DENGAN DRAG-AND-DROP SMOOTH (FITUR 11)
         ============================================================ -->
    <div class="card mb-4 p-3" style="border-radius:16px">
      <div class="flex justify-between align-center wrap gap-2 mb-3">
        <div>
          <h3 style="font-size:16px;color:var(--navy-900);font-weight:700">
            Papan Kendali Observasi Guru (Drag &amp; Drop Reorder)
          </h3>
          <p class="tiny muted" style="margin-top:2px">
            Geser kartu observasi guru antar-kolom untuk mengubah tahapan pelaksanaan supervisi secara mulus.
          </p>
        </div>
        <div>
          <span class="badge badge-teal font-bold"><svg class="ic ic-sm"><use href="#i-refresh"></use></svg> Realtime Board</span>
        </div>
      </div>

      <div class="grid grid-3 gap-3">
        <!-- KOLOM 1: TERJADWAL -->
        <div class="kanban-col" id="colTerjadwal" ondragover="handleDragOver(event)" ondrop="handleDrop(event, 'Terjadwal')">
          <div class="flex justify-between align-center mb-1">
            <span class="font-bold text-orange flex align-center gap-1" style="font-size:13px">
              <svg class="ic ic-sm"><use href="#i-clock"></use></svg> 1. Terjadwal / Siap
            </span>
            <span class="badge badge-warning" id="countTerjadwal">2</span>
          </div>

          <div class="kanban-card drag-item" draggable="true" id="card-1" ondragstart="handleDragStart(event, 1)">
            <div class="flex justify-between align-center mb-1">
              <span class="badge badge-teal" style="font-size:10.5px">Informatika &middot; X-A</span>
              <span class="tiny text-muted">26 Okt 2026</span>
            </div>
            <div class="font-bold" style="color:var(--navy-900)">Dewi Kartika, S.Pd</div>
            <div class="tiny muted mb-2">Materi: Algoritma &amp; Pemrograman</div>
            <div class="flex justify-between align-center">
              <span class="badge-status badge-status-pending">Menunggu</span>
              <a href="/sim-gtk/penilaian/mengajar" class="btn btn-outline btn-xs">Mulai Observasi</a>
            </div>
          </div>

          <div class="kanban-card drag-item" draggable="true" id="card-2" ondragstart="handleDragStart(event, 2)">
            <div class="flex justify-between align-center mb-1">
              <span class="badge badge-teal" style="font-size:10.5px">Bahasa Inggris &middot; XI-1</span>
              <span class="tiny text-muted">28 Okt 2026</span>
            </div>
            <div class="font-bold" style="color:var(--navy-900)">Ahmad Zulkifli, M.Pd</div>
            <div class="tiny muted mb-2">Materi: Analytical Exposition</div>
            <div class="flex justify-between align-center">
              <span class="badge-status badge-status-pending">Menunggu</span>
              <a href="/sim-gtk/penilaian/perangkat" class="btn btn-outline btn-xs">Telaah Modul</a>
            </div>
          </div>
        </div>

        <!-- KOLOM 2: PROSES OBSERVASI -->
        <div class="kanban-col" id="colProses" ondragover="handleDragOver(event)" ondrop="handleDrop(event, 'Proses')">
          <div class="flex justify-between align-center mb-1">
            <span class="font-bold text-blue flex align-center gap-1" style="font-size:13px">
              <svg class="ic ic-sm"><use href="#i-eye"></use></svg> 2. Sedang Diobservasi
            </span>
            <span class="badge badge-info" id="countProses">1</span>
          </div>

          <div class="kanban-card drag-item" draggable="true" id="card-3" ondragstart="handleDragStart(event, 3)">
            <div class="flex justify-between align-center mb-1">
              <span class="badge badge-teal" style="font-size:10.5px">Matematika &middot; XII-2</span>
              <span class="tiny text-blue font-bold">Hari Ini</span>
            </div>
            <div class="font-bold" style="color:var(--navy-900)">Rina Anggraini, S.Si</div>
            <div class="tiny muted mb-2">Materi: Integral Substitusi Aljabar</div>
            <div class="flex justify-between align-center">
              <span class="badge-status badge-status-aktif">Di Kelas</span>
              <a href="/sim-gtk/penilaian/akademik" class="btn btn-primary btn-xs">Form Nilai</a>
            </div>
          </div>
        </div>

        <!-- KOLOM 3: SELESAI / TERBIT NILAI -->
        <div class="kanban-col" id="colSelesai" ondragover="handleDragOver(event)" ondrop="handleDrop(event, 'Selesai')">
          <div class="flex justify-between align-center mb-1">
            <span class="font-bold text-green flex align-center gap-1" style="font-size:13px">
              <svg class="ic ic-sm"><use href="#i-check-circle"></use></svg> 3. Selesai Tervalidasi
            </span>
            <span class="badge badge-success" id="countSelesai">3</span>
          </div>

          <div class="kanban-card drag-item" draggable="true" id="card-4" ondragstart="handleDragStart(event, 4)">
            <div class="flex justify-between align-center mb-1">
              <span class="badge badge-teal" style="font-size:10.5px">Fisika &middot; X-B</span>
              <span class="tiny text-green font-bold">Skor: 92 (A)</span>
            </div>
            <div class="font-bold" style="color:var(--navy-900)">Faisal Bakari, S.Pd</div>
            <div class="tiny muted mb-2">Materi: Pengukuran &amp; Ketidakpastian</div>
            <div class="flex justify-between align-center">
              <span class="badge-status badge-status-selesai">Selesai</span>
              <a href="/sim-gtk/penilaian/laporan" class="btn btn-outline btn-xs">Lihat Hasil</a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ============================================================
         TABEL AGENDA OBSERVASI MOBILE-CARD RESPONSIVE (FITUR 4)
         ============================================================ -->
    <div class="card mb-4" style="padding:0;overflow:hidden;border-radius:16px">
      <div class="card-head p-3 flex justify-between align-center wrap gap-2" style="background:#f8fafc;border-bottom:1px solid var(--line);margin:0">
        <div>
          <h3 style="font-size:16px;color:var(--navy-900);font-weight:700">
            Daftar Agenda Supervisi Guru Sejawat
          </h3>
          <p class="tiny muted" style="margin-top:2px">
            Tabel otomatis beradaptasi menjadi kartu vertikal saat dibuka pada layar ponsel / tablet.
          </p>
        </div>
        <div>
          <a href="/sim-gtk/penilaian/jadwal" class="btn btn-outline btn-sm">Buka Kalender Lengkap</a>
        </div>
      </div>

      <div class="table-responsive plain">
        <table class="table tbl table-mobile-card mb-0">
          <thead>
            <tr>
              <th style="width:50px;text-align:center">No</th>
              <th>Tanggal</th>
              <th>Guru Sasaran Observasi</th>
              <th>Mapel &amp; Kelas</th>
              <th>Supervisor Penilai</th>
              <th style="text-align:center">Status</th>
              <th style="text-align:center">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (jadwalList && jadwalList.length > 0) { %>
              <% jadwalList.forEach(function(item, idx) { %>
                <tr>
                  <td data-label="No" style="text-align:center;font-weight:700"><%= idx + 1 %></td>
                  <td data-label="Tanggal">
                    <b><%= item.tanggal %></b>
                    <span class="tiny muted display-block"><%= item.jam || '08:00 - 09:30' %></span>
                  </td>
                  <td data-label="Guru Sasaran">
                    <div class="font-bold text-blue"><%= item.gtk_nama %></div>
                    <div class="tiny muted"><%= item.gtk_nip && item.gtk_nip !== '-' ? 'NIP. ' + item.gtk_nip : 'NUPTK: ' + (item.gtk_nuptk || '-') %></div>
                  </td>
                  <td data-label="Mapel & Kelas">
                    <span class="badge badge-teal"><%= item.mapel || 'Informatika' %></span>
                    <span class="tiny muted"><%= item.kelas ? 'Kelas ' + item.kelas : '' %></span>
                  </td>
                  <td data-label="Supervisor">
                    <span class="font-semibold"><%= item.supervisor_nama %></span>
                  </td>
                  <td data-label="Status" style="text-align:center">
                    <% if (item.status === 'Selesai') { %>
                      <span class="badge-status badge-status-selesai">Selesai</span>
                    <% } else { %>
                      <span class="badge-status badge-status-pending">Terjadwal</span>
                    <% } %>
                  </td>
                  <td data-label="Aksi" style="text-align:center">
                    <a href="/sim-gtk/penilaian/akademik" class="btn btn-primary btn-xs">Nilai 4 Menu</a>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="7" class="center muted p-4">Belum ada agenda supervisi mandiri.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </main>
</div>

<!-- JAVASCRIPT SMOOTH DRAG & DROP -->
<script>
let draggedCardId = null;

function handleDragStart(e, id) {
  draggedCardId = id;
  e.dataTransfer.setData('text/plain', id);
  e.target.classList.add('dragging');
}

function handleDragOver(e) {
  e.preventDefault();
  const col = e.currentTarget;
  col.classList.add('drag-over');
}

function handleDrop(e, targetStatus) {
  e.preventDefault();
  const col = e.currentTarget;
  col.classList.remove('drag-over');

  const card = document.getElementById('card-' + draggedCardId);
  if (card) {
    card.classList.remove('dragging');
    col.appendChild(card);
    
    // Smooth toast feedback
    const toast = document.createElement('div');
    toast.className = 'toast-notice show';
    toast.innerHTML = '<svg class="ic ic-sm" style="color:#10b981"><use href="#i-check"></use></svg> Status supervisi berhasil diperbarui ke: <b>' + targetStatus + '</b>';
    document.body.appendChild(toast);
    setTimeout(() => {
      toast.classList.remove('show');
      setTimeout(() => toast.remove(), 300);
    }, 2500);
  }
}

document.addEventListener('dragend', function(e) {
  if (e.target && e.target.classList) {
    e.target.classList.remove('dragging');
  }
  document.querySelectorAll('.kanban-col').forEach(c => c.classList.remove('drag-over'));
});
</script>

<%- include('../partials/footer') %>
