<%- include("../partials/head", { title: "Masuk", bodyClass: "auth-body" }) %>


<div class="auth-wrap">
  <div class="auth-card">
    <div class="flex align-center gap-1">
      <span class="brand-mark" aria-hidden="true">
  <svg viewBox="0 0 96 96" role="img" aria-label="Logo SIM-GTK">
    <defs>
      <linearGradient id="bllog" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#1565b8"/><stop offset="1" stop-color="#0d3f7c"/>
      </linearGradient>
      <linearGradient id="bglog" x1="0" y1="1" x2="1" y2="0">
        <stop offset="0" stop-color="#2a9d4f"/><stop offset="1" stop-color="#8dc63f"/>
      </linearGradient>
    </defs>
    <rect x="9" y="20" width="78" height="58" rx="11" fill="#ffffff" stroke="url(#bllog)" stroke-width="5"/>
    <circle cx="36" cy="45" r="8" fill="#0d3f7c"/>
    <path d="M22 66c0-8 6-13 14-13s14 5 14 13z" fill="#0d3f7c"/>
    <rect x="58" y="56" width="7" height="11" rx="2" fill="#8dc63f"/>
    <rect x="68" y="49" width="7" height="18" rx="2" fill="url(#bglog)"/>
    <rect x="78" y="42" width="7" height="25" rx="2" fill="#2a9d4f"/>
    <path d="M30 17 56 6l26 11-26 11z" fill="url(#bllog)"/>
    <path d="M74 17v9" stroke="#0d3f7c" stroke-width="2.4" stroke-linecap="round"/>
    <circle cx="74" cy="28" r="3" fill="#2a9d4f"/>
    <path d="M16 70c22 12 44 12 66-6" fill="none" stroke="url(#bglog)" stroke-width="5.5" stroke-linecap="round"/>
  </svg>
</span>
<span class="brand-text">
  <span class="wordmark"><span class="w-sim">SIM-</span><span class="w-gtk">GTK</span></span>
  <span class="brand-sub">Sistem Informasi Manajemen GTK</span>
</span>

    </div>
    <h1>Masuk Ke SIM-GTK</h1>
    <div class="sub">Sistem Informasi Manajemen Guru dan Tenaga Kependidikan Madrasah</div>

    
    

    <form method="post" action="/sim-gtk/login" autocomplete="on">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="next" value="">
      <div class="field">
        <label for="ident">Email / Username</label>
        <input id="ident" name="ident" type="text" value="" placeholder="nama@madrasah.sch.id atau username" required autofocus>
      </div>
      <div class="field">
        <label for="password">Kata Sandi</label>
        <div class="pass-wrap">
          <input id="password" name="password" type="password" placeholder="••••••••" required>
          <button type="button" class="pass-toggle" data-pass-toggle="password" aria-label="Tampilkan kata sandi"><svg class="ic " aria-hidden="true"><use href="#i-eye"></use></svg></button>
        </div>
      </div>
      <button class="btn btn-primary btn-block" type="submit"><svg class="ic ic-sm" aria-hidden="true"><use href="#i-logout"></use></svg> Masuk</button>
    </form>

    <div style="display:flex;align-items:center;gap:12px;margin:20px 0 0">
      <span style="flex:1;height:1px;background:var(--line)"></span>
      <span class="tiny muted">atau</span>
      <span style="flex:1;height:1px;background:var(--line)"></span>
    </div>

    <div class="auth-note">
      <svg class="ic ic-sm" aria-hidden="true"><use href="#i-info"></use></svg>
      <div>Akun <b>Guru</b>, <b>Admin Madrasah</b>, dan <b>Pengawas</b> diterbitkan oleh admin madrasah / dinas pengawas. Jika akun baru didaftarkan, tunggu persetujuan admin madrasah terlebih dahulu. Jika tombol belum berubah, silakan refresh halaman.</div>
    </div>

    <a class="btn btn-outline btn-block" href="/sim-gtk/register"><svg class="ic ic-sm" aria-hidden="true"><use href="#i-user"></use></svg> Daftar akun GTK baru</a>

    <div class="demo-box">
      <b>Akun demo:</b><br>
      Admin madrasah &nbsp;<code>admin@man2gorontalo.sch.id</code> / <code>admin123</code><br>
      Guru &nbsp;<code>herman@man2gorontalo.sch.id</code> / <code>guru123</code><br>
      Pengawas &nbsp;<code>pengawas@kemenag.go.id</code> / <code>pengawas123</code><br>
      Super admin &nbsp;<code>superadmin@sim-gtk.id</code> / <code>admin123</code>
    </div>

    <div class="auth-alt"><a href="/sim-gtk/panduan">Klik di sini</a> untuk melihat panduan aplikasi</div>
    <div class="auth-foot">&copy; 2026 SIM-GTK &middot; Rumah Digital Guru dan Tenaga Kependidikan Madrasah</div>
  </div>
</div>
<%- include("../partials/footer") %>


