<%- include('../partials/head') %>
<%- include('../partials/topbar') %>
<div class="shell">
  <%- include('../partials/sidebar') %>
  <main class="main">
    
    <!-- BREADCRUMB & HEADER -->
    <div class="breadcrumb">
      <a href="/sim-gtk/beranda">Beranda</a>
      <span class="sep">/</span>
      <a href="/sim-gtk/superadmin/dashboard">Super Admin</a>
      <span class="sep">/</span>
      <span>Manajemen Lembaga</span>
    </div>

    <div class="page-header flex justify-between align-center wrap gap-1">
      <div>
        <h1 class="page-title flex align-center gap-1">
          <svg class="ic text-blue" style="width:28px;height:28px"><use href="#i-school"></use></svg>
          Manajemen Lembaga &amp; Satuan Pendidikan
        </h1>
        <p class="muted">Registrasi madrasah baru, verifikasi berkas, aktivasi, penangguhan (suspensi), dan pembaruan profil identitas lembaga.</p>
      </div>
      <div>
        <button class="btn btn-primary" onclick="openModal('modalTambahLembaga')">
          <svg class="ic ic-sm"><use href="#i-plus"></use></svg> Registrasi Lembaga Baru
        </button>
      </div>
    </div>

    <!-- FLASH MESSAGE -->
    <% if (flash) { %>
      <div class="alert alert-<%= flash.type %> mb-3">
        <%= flash.message %>
      </div>
    <% } %>

    <!-- SUMMARY CARDS -->
    <div class="grid grid-4 mb-3">
      <div class="card p-2 flex justify-between align-center">
        <div>
          <div class="tiny muted uppercase">Total Lembaga</div>
          <div class="h3" style="font-size:22px;font-weight:700"><%= lembagas.length %></div>
        </div>
        <span class="badge badge-primary">Semua Jenjang</span>
      </div>
      <div class="card p-2 flex justify-between align-center">
        <div>
          <div class="tiny muted uppercase">Status Aktif</div>
          <div class="h3 text-green" style="font-size:22px;font-weight:700">
            <%= lembagas.filter(l => l.status === 'aktif').length %>
          </div>
        </div>
        <span class="badge badge-success">Beroperasi</span>
      </div>
      <div class="card p-2 flex justify-between align-center">
        <div>
          <div class="tiny muted uppercase">Menunggu Verifikasi</div>
          <div class="h3 text-orange" style="font-size:22px;font-weight:700">
            <%= lembagas.filter(l => l.status === 'menunggu_verifikasi').length %>
          </div>
        </div>
        <span class="badge badge-warning">Perlu Tindakan</span>
      </div>
      <div class="card p-2 flex justify-between align-center">
        <div>
          <div class="tiny muted uppercase">Ditangguhkan (Suspend)</div>
          <div class="h3 text-danger" style="font-size:22px;font-weight:700">
            <%= lembagas.filter(l => l.status === 'ditangguhkan').length %>
          </div>
        </div>
        <span class="badge badge-danger">Akses Dikunci</span>
      </div>
    </div>

    <!-- TABEL & FILTER LEMBAGA -->
    <div class="card">
      <div class="card-head flex justify-between align-center wrap gap-1">
        <div class="flex align-center gap-1">
          <input type="text" id="searchLembaga" class="form-control" style="width:260px" placeholder="Cari nama lembaga / NPSN..." onkeyup="filterLembaga()">
          <select id="filterJenjang" class="form-control" style="width:140px" onchange="filterLembaga()">
            <option value="">Semua Jenjang</option>
            <option value="MA">MA</option>
            <option value="MTs">MTs</option>
            <option value="MI">MI</option>
            <option value="RA">RA</option>
          </select>
          <select id="filterStatus" class="form-control" style="width:170px" onchange="filterLembaga()">
            <option value="">Semua Status</option>
            <option value="aktif">Aktif</option>
            <option value="menunggu_verifikasi">Menunggu Verifikasi</option>
            <option value="ditangguhkan">Ditangguhkan</option>
          </select>
        </div>
        <span class="tiny muted" id="countLabel">Menampilkan <%= lembagas.length %> lembaga</span>
      </div>

      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table" id="tableLembaga">
            <thead>
              <tr>
                <th style="width:110px">NPSN</th>
                <th>Nama Satuan Pendidikan</th>
                <th style="width:80px">Jenjang</th>
                <th>Kabupaten / Kota</th>
                <th>Kepala Madrasah</th>
                <th>Kapasitas GTK</th>
                <th>Paket Layanan</th>
                <th>Status</th>
                <th style="width:190px;text-align:center">Aksi Manajemen</th>
              </tr>
            </thead>
            <tbody>
              <% lembagas.forEach(function(l) { %>
                <tr data-jenjang="<%= l.jenjang %>" data-status="<%= l.status %>" data-search="<%= (l.nama + ' ' + l.npsn + ' ' + l.kabupaten).toLowerCase() %>">
                  <td><b><%= l.npsn || '-' %></b></td>
                  <td>
                    <div style="font-weight:600"><%= l.nama %></div>
                    <div class="tiny muted"><%= l.email || '-' %> &middot; <%= l.telepon || '-' %></div>
                  </td>
                  <td><span class="badge badge-info"><%= l.jenjang %></span></td>
                  <td><%= l.kabupaten || '-' %>, <%= l.provinsi || 'Gorontalo' %></td>
                  <td><%= l.nama_kamad || '-' %></td>
                  <td>
                    <span class="badge badge-sm badge-secondary"><%= l.kapasitas_gtk || 100 %> GTK</span>
                  </td>
                  <td>
                    <span class="badge badge-teal badge-sm"><%= l.paket_layanan || 'Standard Madrasah' %></span>
                  </td>
                  <td>
                    <% if (l.status === 'aktif') { %>
                      <span class="badge badge-success">Aktif</span>
                    <% } else if (l.status === 'menunggu_verifikasi') { %>
                      <span class="badge badge-warning">Menunggu Verifikasi</span>
                    <% } else { %>
                      <span class="badge badge-danger">Ditangguhkan</span>
                    <% } %>
                  </td>
                  <td style="text-align:center">
                    <div class="flex gap-1 justify-center align-center">
                      
                      <!-- TOMBOL VERIFIKASI JIKA STATUS MENUNGGU -->
                      <% if (l.status === 'menunggu_verifikasi') { %>
                        <form method="post" action="/sim-gtk/superadmin/lembaga/<%= l.id %>/verifikasi" style="display:inline">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button type="submit" class="btn btn-success btn-xs" title="Verifikasi &amp; Aktifkan Lembaga">
                            <svg class="ic ic-sm"><use href="#i-check"></use></svg> Verifikasi
                          </button>
                        </form>
                      <% } %>

                      <!-- TOGGLE SUSPEND / AKTIFKAN -->
                      <% if (l.status === 'aktif') { %>
                        <form method="post" action="/sim-gtk/superadmin/lembaga/<%= l.id %>/status" style="display:inline" onsubmit="return confirm('Apakah Anda yakin ingin menangguhkan (suspend) akses madrasah ini?')">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <input type="hidden" name="status" value="ditangguhkan">
                          <button type="submit" class="btn btn-danger btn-xs" title="Tangguhkan Akses Lembaga">
                            <svg class="ic ic-sm"><use href="#i-lock"></use></svg> Suspend
                          </button>
                        </form>
                      <% } else if (l.status === 'ditangguhkan') { %>
                        <form method="post" action="/sim-gtk/superadmin/lembaga/<%= l.id %>/status" style="display:inline">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <input type="hidden" name="status" value="aktif">
                          <button type="submit" class="btn btn-primary btn-xs" title="Buka Penangguhan (Aktifkan)">
                            <svg class="ic ic-sm"><use href="#i-refresh"></use></svg> Aktifkan
                          </button>
                        </form>
                      <% } %>

                      <!-- TOMBOL EDIT IDENTITAS -->
                      <button type="button" class="btn btn-outline btn-xs" title="Perbarui Identitas Lembaga" onclick='editLembaga(<%= JSON.stringify(l) %>)'>
                        <svg class="ic ic-sm"><use href="#i-edit"></use></svg> Edit
                      </button>

                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- MODAL REGISTRASI LEMBAGA BARU -->
    <div class="modal" id="modalTambahLembaga">
      <div class="modal-dialog">
        <form method="post" action="/sim-gtk/superadmin/lembaga">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="modal-head">
            <h3 style="font-size:16px;margin:0">Registrasi Lembaga / Madrasah Baru</h3>
            <button type="button" class="btn-close" onclick="closeModal('modalTambahLembaga')">&times;</button>
          </div>
          <div class="modal-body">
            <div class="grid grid-2 gap-1 mb-2">
              <div>
                <label class="form-label required">NPSN</label>
                <input type="text" name="npsn" class="form-control" required placeholder="Contoh: 40401234">
              </div>
              <div>
                <label class="form-label required">Jenjang</label>
                <select name="jenjang" class="form-control" required>
                  <option value="MA">Madrasah Aliyah (MA)</option>
                  <option value="MTs">Madrasah Tsanawiyah (MTs)</option>
                  <option value="MI">Madrasah Ibtidaiyah (MI)</option>
                  <option value="RA">Raudhatul Athfal (RA)</option>
                </select>
              </div>
            </div>

            <div class="mb-2">
              <label class="form-label required">Nama Resmi Lembaga / Satuan Pendidikan</label>
              <input type="text" name="nama" class="form-control" required placeholder="Contoh: MAN 3 KABUPATEN GORONTALO">
            </div>

            <div class="grid grid-2 gap-1 mb-2">
              <div>
                <label class="form-label required">Kabupaten / Kota</label>
                <input type="text" name="kabupaten" class="form-control" required value="Kabupaten Gorontalo">
              </div>
              <div>
                <label class="form-label required">Provinsi</label>
                <input type="text" name="provinsi" class="form-control" required value="Gorontalo">
              </div>
            </div>

            <div class="mb-2">
              <label class="form-label">Alamat Lengkap</label>
              <input type="text" name="alamat" class="form-control" placeholder="Jalan, No, Desa/Kelurahan, Kecamatan">
            </div>

            <div class="grid grid-2 gap-1 mb-2">
              <div>
                <label class="form-label">Nama Kepala Madrasah</label>
                <input type="text" name="nama_kamad" class="form-control" placeholder="Nama lengkap beserta gelar">
              </div>
              <div>
                <label class="form-label">No. Telepon / WhatsApp</label>
                <input type="text" name="telepon" class="form-control" placeholder="0435-xxxx atau 0812xxxx">
              </div>
            </div>

            <div class="grid grid-2 gap-1 mb-2">
              <div>
                <label class="form-label required">Email Resmi</label>
                <input type="email" name="email" class="form-control" required placeholder="madrasah@kemenag.go.id">
              </div>
              <div>
                <label class="form-label required">Paket Layanan</label>
                <select name="paket_layanan" class="form-control">
                  <option value="Standard Madrasah">Standard Madrasah (100 GTK)</option>
                  <option value="Starter Madrasah Swasta">Starter Madrasah Swasta (40 GTK)</option>
                  <option value="Enterprise Kanwil">Enterprise Kanwil (300 GTK)</option>
                </select>
              </div>
            </div>

            <div class="mb-2">
              <label class="form-label">Status Awal</label>
              <select name="status" class="form-control">
                <option value="aktif">Langsung Aktif</option>
                <option value="menunggu_verifikasi">Menunggu Verifikasi Dokumen</option>
              </select>
            </div>
          </div>
          <div class="modal-foot flex justify-end gap-1">
            <button type="button" class="btn btn-outline" onclick="closeModal('modalTambahLembaga')">Batal</button>
            <button type="submit" class="btn btn-primary">Simpan &amp; Daftarkan Lembaga</button>
          </div>
        </form>
      </div>
    </div>

    <!-- MODAL EDIT PEMBARUAN IDENTITAS LEMBAGA -->
    <div class="modal" id="modalEditLembaga">
      <div class="modal-dialog">
        <form method="post" id="formEditLembaga" action="/sim-gtk/superadmin/lembaga/update">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="id" id="edit_id">
          <div class="modal-head">
            <h3 style="font-size:16px;margin:0">Pembaruan Identitas Lembaga</h3>
            <button type="button" class="btn-close" onclick="closeModal('modalEditLembaga')">&times;</button>
          </div>
          <div class="modal-body">
            <div class="grid grid-2 gap-1 mb-2">
              <div>
                <label class="form-label required">NPSN</label>
                <input type="text" name="npsn" id="edit_npsn" class="form-control" required>
              </div>
              <div>
                <label class="form-label required">Jenjang</label>
                <select name="jenjang" id="edit_jenjang" class="form-control" required>
                  <option value="MA">Madrasah Aliyah (MA)</option>
                  <option value="MTs">Madrasah Tsanawiyah (MTs)</option>
                  <option value="MI">Madrasah Ibtidaiyah (MI)</option>
                  <option value="RA">Raudhatul Athfal (RA)</option>
                </select>
              </div>
            </div>

            <div class="mb-2">
              <label class="form-label required">Nama Lembaga</label>
              <input type="text" name="nama" id="edit_nama" class="form-control" required>
            </div>

            <div class="grid grid-2 gap-1 mb-2">
              <div>
                <label class="form-label required">Kabupaten / Kota</label>
                <input type="text" name="kabupaten" id="edit_kabupaten" class="form-control" required>
              </div>
              <div>
                <label class="form-label required">Provinsi</label>
                <input type="text" name="provinsi" id="edit_provinsi" class="form-control" required>
              </div>
            </div>

            <div class="mb-2">
              <label class="form-label">Alamat Lengkap</label>
              <input type="text" name="alamat" id="edit_alamat" class="form-control">
            </div>

            <div class="grid grid-2 gap-1 mb-2">
              <div>
                <label class="form-label">Nama Kepala Madrasah</label>
                <input type="text" name="nama_kamad" id="edit_nama_kamad" class="form-control">
              </div>
              <div>
                <label class="form-label">No. Telepon</label>
                <input type="text" name="telepon" id="edit_telepon" class="form-control">
              </div>
            </div>

            <div class="grid grid-2 gap-1 mb-2">
              <div>
                <label class="form-label required">Email Resmi</label>
                <input type="email" name="email" id="edit_email" class="form-control" required>
              </div>
              <div>
                <label class="form-label">Kapasitas Maksimal GTK</label>
                <input type="number" name="kapasitas_gtk" id="edit_kapasitas_gtk" class="form-control" min="10" max="500">
              </div>
            </div>
          </div>
          <div class="modal-foot flex justify-end gap-1">
            <button type="button" class="btn btn-outline" onclick="closeModal('modalEditLembaga')">Batal</button>
            <button type="submit" class="btn btn-primary">Simpan Pembaruan Identitas</button>
          </div>
        </form>
      </div>
    </div>

  </main>
</div>

<script>
function openModal(id) {
  document.getElementById(id).classList.add('open');
}
function closeModal(id) {
  document.getElementById(id).classList.remove('open');
}

function editLembaga(data) {
  document.getElementById('edit_id').value = data.id;
  document.getElementById('edit_npsn').value = data.npsn || '';
  document.getElementById('edit_jenjang').value = data.jenjang || 'MA';
  document.getElementById('edit_nama').value = data.nama || '';
  document.getElementById('edit_kabupaten').value = data.kabupaten || '';
  document.getElementById('edit_provinsi').value = data.provinsi || '';
  document.getElementById('edit_alamat').value = data.alamat || '';
  document.getElementById('edit_nama_kamad').value = data.nama_kamad || '';
  document.getElementById('edit_telepon').value = data.telepon || '';
  document.getElementById('edit_email').value = data.email || '';
  document.getElementById('edit_kapasitas_gtk').value = data.kapasitas_gtk || 100;
  openModal('modalEditLembaga');
}

function filterLembaga() {
  const q = document.getElementById('searchLembaga').value.toLowerCase();
  const j = document.getElementById('filterJenjang').value;
  const s = document.getElementById('filterStatus').value;
  const rows = document.querySelectorAll('#tableLembaga tbody tr');
  let shown = 0;

  rows.forEach(r => {
    const rSearch = r.getAttribute('data-search') || '';
    const rJenjang = r.getAttribute('data-jenjang') || '';
    const rStatus = r.getAttribute('data-status') || '';

    const matchQ = !q || rSearch.includes(q);
    const matchJ = !j || rJenjang === j;
    const matchS = !s || rStatus === s;

    if (matchQ && matchJ && matchS) {
      r.style.display = '';
      shown++;
    } else {
      r.style.display = 'none';
    }
  });

  document.getElementById('countLabel').innerText = 'Menampilkan ' + shown + ' lembaga';
}
</script>

<%- include('../partials/footer') %>
