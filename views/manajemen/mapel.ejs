              <td class="num">0</td>
              <td class="right">
                <form method="post" action="/sim-gtk/manajemen/mapel/12/hapus" data-confirm="Hapus mapel Pendidikan Pancasila?">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
