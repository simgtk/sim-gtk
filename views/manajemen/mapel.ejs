              <td class="strong">Akidah Akhlak</td>
              <td><span class="badge badge-teal">Agama</span></td>
              <td class="num">0</td>
              <td class="right">
                <form method="post" action="/sim-gtk/manajemen/mapel/4/hapus" data-confirm="Hapus mapel Akidah Akhlak?">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-danger btn-sm" type="submit"><svg class="ic ic-sm" aria-hidden="true"><use href="#i-trash"></use></svg></button>
                </form>
              </td>
            </tr>
          
            <tr>
              <td><span class="badge badge-muted">QUR</span></td>
