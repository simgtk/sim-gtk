<%- include('../partials/head', { title: "Mata Pelajaran", bodyClass: '' }) %>
<%- include('../partials/topbar') %>
<div class="shell">
  <%- include('../partials/sidebar') %>
  <main class="main">

    
    <div class="crumbs no-print">
      <a href="/sim-gtk/beranda">SIM-GTK</a> <span>/</span> <b>Mata Pelajaran</b>
    </div>
    <div class="page-head">
      <h1>Mata Pelajaran</h1>
      <p>Daftar mata pelajaran yang diajarkan di madrasah</p>
    </div>

<div class="grid" style="grid-template-columns:1.6fr 1fr">
