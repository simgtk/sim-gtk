                </form>
              </td>
            </tr>
          
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><div><h3>Tambah Mata Pelajaran</h3><p>Mapel digunakan pada jadwal dan perangkat ajar</p></div></div>
    <form method="post" action="/sim-gtk/manajemen/mapel">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field mb-2"><label>Kode</label><input name="kode" type="text" placeholder="FIK" maxlength="6"></div>
      <div class="field mb-2"><label>Nama Mata Pelajaran</label><input name="nama" type="text" placeholder="Fikih" required></div>
      <div class="field mb-2"><label>Kelompok</label><select name="kelompok"><option>Agama</option><option>Umum</option><option>Bahasa</option><option>Kejuruan</option><option>Muatan Lokal</option></select></div>
      <button class="btn btn-primary btn-block" type="submit"><svg class="ic ic-sm" aria-hidden="true"><use href="#i-plus"></use></svg> Tambah Mapel</button>
    </form>
    <div class="alert alert-info mt-2"><svg class="ic " aria-hidden="true"><use href="#i-info"></use></svg><div>Mapel yang sudah dipakai pada jadwal tidak dapat dihapus.</div></div>
  </div>
</div>
    
    <div class="tiny muted mt-4" style="padding-top:18px;border-top:1px solid var(--line)">
      SIM-GTK &mdash; Sistem Informasi Manajemen Guru dan Tenaga Kependidikan Madrasah. Semua data ditampilkan sesuai madrasah dan hak akses akun Anda.
    </div>
  </main>
