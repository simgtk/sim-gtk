              <td class="num">12</td>
              <td class="right">
                <form method="post" action="/sim-gtk/manajemen/mapel/1/hapus" data-confirm="Hapus mapel Fikih?">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-danger btn-sm" type="submit"><svg class="ic ic-sm" aria-hidden="true"><use href="#i-trash"></use></svg></button>
