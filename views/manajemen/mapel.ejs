            </tr>
          
            <tr>
              <td><span class="badge badge-muted">INF</span></td>
              <td class="strong">Informatika</td>
              <td><span class="badge badge-muted">Umum</span></td>
              <td class="num">0</td>
              <td class="right">
                <form method="post" action="/sim-gtk/manajemen/mapel/11/hapus" data-confirm="Hapus mapel Informatika?">
