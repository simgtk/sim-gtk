<%- include('../partials/head', { title: "Jadwal Pelajaran", bodyClass: '' }) %>
<%- include('../partials/topbar') %>
<div class="shell">
  <%- include('../partials/sidebar') %>
  <main class="main">

    
    <div class="crumbs no-print">
      <a href="/sim-gtk/beranda">SIM-GTK</a> <span>/</span> <b>Jadwal Pelajaran</b>
    </div>
    <div class="page-head">
      <h1>Jadwal Pelajaran</h1>
      <p>Susun jadwal tatap muka madrasah</p>
    </div>

<div class="grid" style="grid-template-columns:1fr 1.7fr">
  <div class="stack">
    <div class="card">
      <div class="card-head"><div><h3>Tambah Jadwal</h3><p>Sistem otomatis memeriksa bentrok jadwal</p></div></div>
      <form method="post" action="/sim-gtk/manajemen/jadwal">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field mb-2"><label>Guru Pengampu</label>
          <select name="guru_id" required><option value="">— pilih guru —</option><option value="5">Ahmad Fauzi, S.Ag</option><option value="6">Dewi Kartika, S.Pd</option><option value="8">Fatimah Zahra, S.Pd</option><option value="3">Herman Susanto Buhungo</option><option value="12">Herman Susanto Buhungo, S.Pd</option><option value="4">Nurhayati, S.Pd</option><option value="7">Rahmat Hidayat, S.Pd.I</option><option value="2">Siti Rahmawati, S.Kom</option></select>
        </div>
        <div class="field mb-2"><label>Kelas</label>
          <select name="kelas_id" required><option value="">— pilih kelas —</option><option value="1">X IPA 1</option><option value="2">X IPA 2</option><option value="3">XI IPA 1</option><option value="4">XI IPS 1</option><option value="5">XII IPA 1</option><option value="6">XII IPS 1</option></select>
        </div>
        <div class="field mb-2"><label>Mata Pelajaran</label>
          <select name="mapel_id" required><option value="">— pilih mapel —</option><option value="4">Akidah Akhlak</option><option value="2">Al-Qur&#39;an Hadis</option><option value="5">Bahasa Arab</option><option value="7">Bahasa Indonesia</option><option value="8">Bahasa Inggris</option><option value="1">Fikih</option><option value="9">IPA Terpadu</option><option value="11">Informatika</option><option value="6">Matematika</option><option value="10">PJOK</option><option value="12">Pendidikan Pancasila</option><option value="3">Sejarah Kebudayaan Islam</option></select>
        </div>
        <div class="field mb-2"><label>Hari</label>
          <select name="hari" required><option>Senin</option><option>Selasa</option><option>Rabu</option><option>Kamis</option><option>Jumat</option><option>Sabtu</option></select>
        </div>
        <div class="form-grid">
          <div class="field"><label>Jam Mulai</label><input type="time" name="jam_mulai" value="07:00" required></div>
          <div class="field"><label>Jam Selesai</label><input type="time" name="jam_selesai" value="08:30" required></div>
        </div>
        <div class="field mb-2 mt-2"><label>Ruang</label><input type="text" name="ruang" placeholder="R-101"></div>
        <button class="btn btn-primary btn-block" type="submit"><svg class="ic ic-sm" aria-hidden="true"><use href="#i-plus"></use></svg> Simpan Jadwal</button>
      </form>
    </div>

    <div class="card">
      <div class="card-head"><div><h3>Beban Mengajar</h3><p>Jumlah JP per guru</p></div></div>
      
        <div class="info-row"><span class="k small">Herman Susanto Buhungo</span><span class="v">12 JP <span class="badge badge-warning" style="margin-left:6px">Kurang</span></span></div>
      
        <div class="info-row"><span class="k small">Nurhayati, S.Pd</span><span class="v">4 JP <span class="badge badge-warning" style="margin-left:6px">Kurang</span></span></div>
      
        <div class="info-row"><span class="k small">Dewi Kartika, S.Pd</span><span class="v">4 JP <span class="badge badge-warning" style="margin-left:6px">Kurang</span></span></div>
      
        <div class="info-row"><span class="k small">Ahmad Fauzi, S.Ag</span><span class="v">3 JP <span class="badge badge-warning" style="margin-left:6px">Kurang</span></span></div>
      
        <div class="info-row"><span class="k small">Rahmat Hidayat, S.Pd.I</span><span class="v">3 JP <span class="badge badge-warning" style="margin-left:6px">Kurang</span></span></div>
      
        <div class="info-row"><span class="k small">Fatimah Zahra, S.Pd</span><span class="v">2 JP <span class="badge badge-warning" style="margin-left:6px">Kurang</span></span></div>
      
        <div class="info-row"><span class="k small">Herman Susanto Buhungo, S.Pd</span><span class="v">0 JP <span class="badge badge-warning" style="margin-left:6px">Kurang</span></span></div>
      
    </div>
  </div>

