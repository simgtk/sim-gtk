# Port aplikasi
PORT=3000

# Environment mode: development / production
NODE_ENV=production

# Kunci rahasia session (Ganti dengan string acak dan panjang, minimal 32 karakter)
SESSION_SECRET=ganti-dengan-string-rahasia-acak-yang-panjang-2026

# Cookie Secure (Set ke true jika website sudah menggunakan HTTPS/SSL)
COOKIE_SECURE=false
